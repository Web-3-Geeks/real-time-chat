    { "key": "userIdB", "value": "" },
    { "key": "userIdC", "value": "" },
    { "key": "tokenC", "value": "" },
    { "key": "userIdD", "value": "" },
    { "key": "emailD", "value": "" },
    { "key": "conversationId", "value": "" },
